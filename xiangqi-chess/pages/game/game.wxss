.game-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #8B4513 0%, #654321 100%);
  box-sizing: border-box;
}

.status-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.turn-info {
  display: flex;
  align-items: center;
}

.turn-label {
  font-size: 26rpx;
  color: #DEB887;
}

.turn-value {
  font-size: 28rpx;
  font-weight: bold;
  margin-left: 8rpx;
}

.red-text {
  color: #FF6347;
}

.black-text {
  color: #2F1810;
}

.diff-badge {
  font-size: 22rpx;
  color: #FFD700;
  background: rgba(255,215,0,0.15);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,215,0,0.4);
}

.board-wrapper {
  width: 700rpx;
  height: 780rpx;
  background: #DEB887;
  border-radius: 12rpx;
  border: 6rpx solid #654321;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.5);
  padding: 16rpx;
  box-sizing: border-box;
}

.chess-canvas {
  width: 668rpx;
  height: 748rpx;
}

.tip-bar {
  margin-top: 20rpx;
  padding: 12rpx 32rpx;
  background: rgba(255, 99, 71, 0.85);
  color: white;
  font-size: 26rpx;
  border-radius: 24rpx;
  animation: fadeInOut 2.5s ease-in-out;
}

@keyframes fadeInOut {
  0% { opacity: 0; }
  15% { opacity: 1; }
  85% { opacity: 1; }
  100% { opacity: 0; }
}

.thinking-bar {
  margin-top: 16rpx;
  padding: 10rpx 24rpx;
  background: rgba(0,0,0,0.4);
  color: #DEB887;
  font-size: 24rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.thinking-dot {
  width: 14rpx;
  height: 14rpx;
  background: #FFD700;
  border-radius: 50%;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.control-area {
  display: flex;
  gap: 30rpx;
  margin-top: 40rpx;
  width: 100%;
  justify-content: center;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.1);
  border: 2rpx solid rgba(255,255,255,0.3);
  border-radius: 16rpx;
  gap: 8rpx;
}

.control-btn.btn-enabled {
  background: linear-gradient(135deg, rgba(212, 160, 23, 0.3) 0%, rgba(139, 105, 20, 0.3) 100%);
  border: 2rpx solid #FFD700;
}

.control-btn.btn-disabled {
  opacity: 0.4;
}

.control-btn:active {
  transform: scale(0.95);
}

.btn-icon {
  font-size: 40rpx;
}

.btn-label {
  font-size: 22rpx;
  color: #DEB887;
}
