.home-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #8B4513 0%, #654321 40%, #2F1810 100%);
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 72rpx;
  font-weight: bold;
  color: #FFD700;
  letter-spacing: 12rpx;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.5);
}

.subtitle {
  font-size: 28rpx;
  color: #DEB887;
  margin-top: 16rpx;
  letter-spacing: 8rpx;
}

.board-deco {
  width: 500rpx;
  height: 320rpx;
  margin: 30rpx 0 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.board-frame {
  width: 100%;
  height: 100%;
  background: #DEB887;
  border-radius: 16rpx;
  border: 6rpx solid #8B4513;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.4);
  padding: 20rpx;
  box-sizing: border-box;
}

.board-inner {
  width: 100%;
  height: 100%;
  background: #F5DEB3;
  border: 4rpx solid #8B4513;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.river {
  font-size: 24rpx;
  color: #8B4513;
  font-weight: bold;
  letter-spacing: 4rpx;
  padding: 8rpx 20rpx;
  background: #F5DEB3;
  border-top: 2rpx dashed #8B4513;
  border-bottom: 2rpx dashed #8B4513;
}

.features {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 60rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
  min-width: 180rpx;
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.feature-name {
  font-size: 26rpx;
  color: #FFD700;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 20rpx;
  color: #DEB887;
}

.btn-start {
  width: 400rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #D4A017 0%, #8B6914 100%);
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFD700;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.4);
}

.btn-start:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-text {
  font-size: 34rpx;
  color: #2F1810;
  font-weight: bold;
  letter-spacing: 8rpx;
}

.version {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
}
